# Full Test Configuration (MySQL + S3 required)
# Use this when you need to test with MySQL database

# Database Type (sqlite or mysql)
export DB_TYPE="mysql"
export DATADIR="data"

# MySQL Database (required for DB_TYPE=mysql)
export MYSQL_HOST="localhost"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="entitybase"
export MYSQL_USER="root"
export MYSQL_PASSWORD=""
export MYSQL_POOL_SIZE="20"
export MYSQL_MAX_OVERFLOW="20"
export MYSQL_POOL_TIMEOUT="30"

# S3 Storage (required for statement/revision storage)
export S3_ENDPOINT="http://localhost:9000"
export S3_ACCESS_KEY="fakekey"
export S3_SECRET_KEY="fakesecret"
export S3_REVISIONS_BUCKET="revisions"

# S3 Versioning
export S3_REVISION_VERSION="3.0.0"
export S3_STATEMENT_VERSION="1.0.0"
export S3_QUALIFIER_VERSION="1.0.0"
export S3_REFERENCE_VERSION="1.0.0"
export S3_SNAK_VERSION="1.0.0"
export S3_SITELINK_VERSION="1.0.0"

# Redpanda/Kafka
export KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
export KAFKA_ENTITYCHANGE_JSON_TOPIC="entitybase.entity_change"
export KAFKA_ENTITY_DIFF_TOPIC="entitybase.entity_diff"
export KAFKA_INCREMENTAL_RDF_TOPIC="incremental_rdf_diff"

# Streaming
export STREAMING_ENABLED="true"

# Streaming Versions
export STREAMING_ENTITYCHANGE_VERSION="1.0.0"
export STREAMING_ENDORSECHANGE_VERSION="1.0.0"
export STREAMING_NEWTHANK_VERSION="1.0.0"
export STREAMING_ENTITY_CHANGE_VERSION="1.0.0"
export STREAMING_ENTITY_DIFF_VERSION="2.0.0"
export STREAMING_USER_CHANGE_VERSION="1.0.0"

# Workers
export INCREMENTAL_RDF_ENABLED="true"
export INCREMENTAL_RDF_CONSUMER_GROUP="incremental-rdf-worker"

# Application
export ENTITY_VERSION="2.0.0"
export DANGLING_PROPERTY_ID="P6104"
export LOG_LEVEL="DEBUG"
export ENVIRONMENT="test"
export API_DESCRIPTION="Entitybase test instance with MySQL"
export USER_AGENT="Entitybase/1.0 Test"
export PYTHONPATH=src
