FROM python:3.13-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libffi-dev libssl-dev && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry \
    && POETRY_VIRTUALENVS_CREATE=false poetry install --no-root --no-interaction --only incremental-rdf-worker

FROM python:3.13-slim
WORKDIR /app
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY pyproject.toml /app/pyproject.toml
COPY src/ ./
ENV PYTHONPATH=/app
CMD ["python", "-m", "models.workers.incremental_rdf"]
