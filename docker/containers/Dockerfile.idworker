FROM python:3.13-alpine AS builder
WORKDIR /app
RUN apk add --no-cache gcc musl-dev libffi-dev openssl-dev
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry \
    && POETRY_VIRTUALENVS_CREATE=false poetry install --no-root --no-interaction --only idworker \
    && poetry cache clear pypi --all || true \
    && rm -rf /root/.cache/*

FROM python:3.13-alpine
WORKDIR /app
RUN apk add --no-cache wget
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY pyproject.toml /app/pyproject.toml
COPY src/ ./
ENV PYTHONPATH=/app
ENV WORKER_ID=id-worker
ENV MYSQL_HOST=mysql
ENV MYSQL_PORT=15309
ENV MYSQL_DATABASE=page
ENV MYSQL_USER=root
EXPOSE 8001
CMD ["python", "-m", "models.workers.id_generation.id_generation_worker"]
