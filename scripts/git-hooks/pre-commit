#!/bin/bash
# Pre-commit hook to run be-lint when src/ files are staged

cd "$(dirname "$0")/../.."

# Get staged files in src/ (Added, Copied, Modified)
src_files=$(git diff-index --cached --name-only --diff-filter=ACM HEAD -- src/ 2>/dev/null || echo "")

if [ -n "$src_files" ]; then
    echo "Changes detected in src/. Running be-lint..."
    echo "$src_files"
    make be-lint
fi
